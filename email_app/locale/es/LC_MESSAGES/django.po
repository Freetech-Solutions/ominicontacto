#: email_app/apps.py:26
msgid "Optiene los detalles de la cuenta de correo"
msgstr "Optiene los detalles de la cuenta de correo"

#: email_app/apps.py:30
msgid "Lista las cuentas de correo"
msgstr "Lista las cuentas de correo"

#: email_app/apps.py:34
msgid "Prueba los datos de la cuenta de correo"
msgstr "Prueba los datos de la cuenta de correo"

#: email_app/api/v1/self.py:115
msgid "Invalid credentials or deactivated Account."
msgstr "Credenciales inválidas o cuenta desactivada."

#: email_app/api/v1/account.py:221
#, python-format
msgid ""
"This account cannot be deleted because it is configured in the following "
"campaign(s): %(campaigns)s. Remove the account from those campaigns before "
"deleting it."
msgstr ""
"No se puede eliminar esta cuenta porque está configurada en la(s) "
"siguiente(s) campaña(s): %(campaigns)s. Quite la cuenta de esas campañas "
"antes de eliminarla."

#: email_app/api/v1/conversation.py:121
msgid "The conversation does not exist."
msgstr "La conversación no existe."

#: email_app/api/v1/conversation.py:126
msgid "You do not have access to this conversation."
msgstr "No tenés acceso a esta conversación."

#: email_app/api/v1/conversation.py:156
msgid "This conversation is already being attended by another agent."
msgstr "Esta conversación ya está siendo atendida por otro agente."

#: email_app/api/v1/conversation.py:112
msgid "Provide a message body."
msgstr "Indicá el cuerpo del mensaje."

#: email_app/api/v1/conversation.py:213
msgid "The email could not be sent."
msgstr "No se pudo enviar el correo."

#: email_app/api/v1/conversation.py:277
msgid "The conversation has no campaign."
msgstr "La conversación no tiene campaña."

#: email_app/api/v1/conversation.py:281
msgid "Save the contact before dispositioning the conversation."
msgstr "Guardá el contacto antes de calificar la conversación."
