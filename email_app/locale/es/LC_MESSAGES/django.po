#: api/v1/account.py:274
#, python-format
msgid ""
"This account cannot be deleted because it is configured in the following "
"campaign(s): %(campaigns)s. Remove the account from those campaigns before "
"deleting it."
msgstr ""
"No se puede eliminar esta cuenta porque está configurada en la(s) "
"siguiente(s) campaña(s): %(campaigns)s. Quite la cuenta de esas campañas "
"antes de eliminarla."

