#: api/v1/account.py:274
#, python-format
msgid ""
"This account cannot be deleted because it is configured in the following "
"campaign(s): %(campaigns)s. Remove the account from those campaigns before "
"deleting it."
msgstr ""
"Esta conta não pode ser excluída porque está configurada na(s) seguinte(s) "
"campanha(s): %(campaigns)s. Remova a conta dessas campanhas antes de excluí-"
"la."

#: api/v1/conversation.py:183
msgid "Provide a message body."
msgstr "Forneça o corpo da mensagem."

