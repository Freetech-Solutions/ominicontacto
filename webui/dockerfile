# Node 24 LTS fijo: desde Node 25 la imagen ya no trae corepack.
# La versión de pnpm la fija "packageManager" en package.json (con hash).
FROM node:24-alpine AS dev
RUN corepack enable
WORKDIR /opt/webui-app
COPY package.json .
COPY pnpm-lock.yaml .
COPY pnpm-workspace.yaml .
COPY patches patches
RUN pnpm install --frozen-lockfile
COPY . .
CMD ["pnpm", "dev", "--base=/webui-app/", "--host", "--port=80", "--strictPort"]
